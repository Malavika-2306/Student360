# Student360 Backend Environment Configuration Example
# Copy this file to .env and configure values as needed.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student360

# GitHub OAuth Web Flow (Optional)
# If GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are not provided,
# students can link their GitHub account using a personal access token (least-privilege 'read:user').
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback
FRONTEND_URL=http://localhost:5173
